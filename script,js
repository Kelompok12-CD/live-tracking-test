// 1. Inisialisasi Peta Leaflet (Posisi Default Purwokerto/Banyumas)
const map = L.map('map').setView([-7.421553, 109.225044], 13);

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
  attribution: '© OpenStreetMap contributors'
}).addTo(map);

// 2. Load File Rute GPX dari Komoot / Plotaroute
new L.GPX('rute.gpx', {
  async: true,
  polyline_options: {
    color: '#0066ff',
    opacity: 0.8,
    weight: 5
  }
}).on('loaded', function(e) {
  map.fitBounds(e.target.getBounds());
}).addTo(map);

// 3. Marker Tracker Hardware
let trackerMarker = L.marker([0, 0]).addTo(map);

// 4. Salin Channel ID dari Dashboard ThingSpeak Anda di sini
const CHANNEL_ID = "3570005"; 

async function fetchRealtimeGPS() {
  try {
    const response = await fetch(`https://api.thingspeak.com/channels/${CHANNEL_ID}/feeds/last.json`);
    const data = await response.json();

    if (data.field1 && data.field2) {
      const lat = parseFloat(data.field1);
      const lng = parseFloat(data.field2);
      const rfidUID = data.field3 || "Tidak Ada Tap";
      const newPos = [lat, lng];

      // Update posisi marker & isi Pop-up RFID
      trackerMarker.setLatLng(newPos);
      trackerMarker.bindPopup(`
        <b>Status Perangkat Tracker</b><br>
        <b>Lat:</b> ${lat}<br>
        <b>Lng:</b> ${lng}<br>
        <b>RFID UID:</b> <span style="color:red;">${rfidUID}</span>
      `).openPopup();
      
      map.panTo(newPos);
      console.log("Data Terbaru Diterima:", newPos, rfidUID);
    }
  } catch (error) {
    console.error("Gagal membaca data dari ThingSpeak:", error);
  }
}

// Polling data otomatis setiap 15 detik
setInterval(fetchRealtimeGPS, 15000);
fetchRealtimeGPS();
