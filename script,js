// 1. Inisialisasi Peta Leaflet
const map = L.map('map').setView([-6.200000, 106.816666], 13);

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
  attribution: '© OpenStreetMap contributors'
}).addTo(map);

// 2. Load File Rute & Checkpoint (.gpx) dari GitHub
new L.GPX('rute.gpx', {
  async: true,
  polyline_options: {
    color: '#0066ff',
    opacity: 0.8,
    weight: 5
  },
  marker_options: {
    startIconUrl: 'https://cdn-icons-png.flaticon.com/512/684/684908.png',
    endIconUrl: 'https://cdn-icons-png.flaticon.com/512/684/684908.png',
    wptIconUrls: {
      '': 'https://cdn-icons-png.flaticon.com/512/684/684908.png'
    }
  }
}).on('loaded', function(e) {
  map.fitBounds(e.target.getBounds());
}).addTo(map);

// 3. Marker Tracker ESP32
let trackerMarker = L.marker([0, 0]).addTo(map);

// 4. Konfigurasi Client Supabase (Tempat Penyimpanan Data Broker/Server)
const SUPABASE_URL = "https://PROJECT_ID_ANDA.supabase.co";
const SUPABASE_KEY = "API_KEY_ANON_ANDA";
const supabase = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

// 5. Berlangganan (Subscribe) Perubahan Data Real-time
supabase
  .channel('public:location')
  .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'gps_logs' }, payload => {
    const { lat, lng } = payload.new;
    console.log("Koordinat Baru Diterima:", lat, lng);
    
    // Perbarui posisi marker di peta Leaflet
    const newPos = [lat, lng];
    trackerMarker.setLatLng(newPos);
    map.panTo(newPos);
  })
  .subscribe();
