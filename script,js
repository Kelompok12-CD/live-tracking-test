// 1. Inisialisasi Peta Leaflet dengan koordinat pusat Purwokerto (Area Rute)
const map = L.map('map').setView([-7.4061585, 109.2606522], 14);

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
  attribution: '© OpenStreetMap contributors'
}).addTo(map);

// 2. Load File Rute GPX (rute.gpx)
new L.GPX('rute.gpx', {
  async: true,
  marker_options: {
    startIconUrl: null,
    endIconUrl: null,
    shadowUrl: null
  },
  polyline_options: {
    color: '#0066ff',
    opacity: 0.8,
    weight: 5
  }
}).on('loaded', function(e) {
  // Peta otomatis zoom mengikuti seluruh lintasan rute
  map.fitBounds(e.target.getBounds());
}).addTo(map);

// 3. Tambahkan Marker Checkpoint Statis (Berdasarkan data Waypoint GPX Anda)
const checkpoints = [
  { lat: -7.414365, lng: 109.2566992, name: "CHECKPOINT 1" },
  { lat: -7.407115, lng: 109.2526569, name: "CHECKPOINT 2" },
  { lat: -7.4061568, lng: 109.2606452, name: "FINISH" }
];

checkpoints.forEach(cp => {
  L.marker([cp.lat, cp.lng])
    .addTo(map)
    .bindPopup(`<b>${cp.name}</b>`);
});

// 4. Marker Pelacak Real-Time ESP32
let trackerMarker = L.marker([0, 0]).addTo(map);

// 5. Masukkan ID Channel ThingSpeak Anda di sini
const CHANNEL_ID = "3570005"; 

async function fetchRealtimeGPS() {
  try {
    const response = await fetch(`https://api.thingspeak.com/channels/${CHANNEL_ID}/feeds/last.json`);
    const data = await response.json();

    if (data.field1 && data.field2) {
      const lat = parseFloat(data.field1);
      const lng = parseFloat(data.field2);
      const rfidUID = data.field3 || "Tidak ada tap";
      const newPos = [lat, lng];

      // Update posisi marker pelacak & pop-up informasinya
      trackerMarker.setLatLng(newPos);
      trackerMarker.bindPopup(`
        <b>Status Tracker Hardware</b><br>
        <b>Lat:</b> ${lat}<br>
        <b>Lng:</b> ${lng}<br>
        <b>RFID UID:</b> <span style="color:red; font-weight:bold;">${rfidUID}</span>
      `).openPopup();
      
      map.panTo(newPos);
      console.log("Posisi Hardware Diperbarui:", newPos, rfidUID);
    }
  } catch (error) {
    console.error("Gagal mengambil data dari ThingSpeak:", error);
  }
}

// Update data real-time setiap 15 detik
setInterval(fetchRealtimeGPS, 15000);
fetchRealtimeGPS();
